{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opaline",
  "version": "0.2.1",
  "identifier": "io.github.mooketsimagwaza.opaline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Opaline",
        "width": 1280,
        "height": 800,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MooketsiMagwaza",
    "homepage": "https://github.com/MooketsiMagwaza/opaline",
    "copyright": "Copyright © 2026 MooketsiMagwaza and Opaline contributors",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "An acrylic launcher for your Windows desktop and installed apps.",
    "longDescription": "A fast spatial launcher for Desktop items and virtual panes, with a searchable Windows app catalogue and configurable acrylic blur.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
